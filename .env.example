NUXT_PUBLIC_API_BASE=
# Hide the Diagnostics route (sidebar entry, command palette, Overview footer button)
# and serve a 404 from /diagnostics. Set to `false` in production deployments where
# you don't want to expose raw bridge JSON / session timeline. Defaults to visible.
# NUXT_PUBLIC_SHOW_DIAGNOSTICS=false
# mock = datos locales de demo | gateway = WebSocket en OPENCLAW_GATEWAY_WS (o derivado de OPENCLAW_GATEWAY_URL); HTTP solo sirve dashboard/salud
#
# Ejemplo gateway OpenClaw en localhost (copiar a tu .env descomentando y sustituyendo el token):
# OPENCLAW_BRIDGE_MODE=gateway
# OPENCLAW_GATEWAY_URL=http://127.0.0.1:18789
# OPENCLAW_GATEWAY_WS=ws://127.0.0.1:18789
# OPENCLAW_GATEWAY_TOKEN=<tu-token>
# En LAN, usa la IP del equipo donde corre OpenClaw en lugar de 127.0.0.1; el gateway debe escuchar en bind 0.0.0.0 en ese equipo.
#
# Tailscale (misma tailnet): la IP suele ser 100.x.x.x (ver `tailscale ip -4` en el equipo del gateway).
# Sustituye PLACEHOLDER por esa IP y el puerto real del gateway. Si el gateway usa TLS, usa https:// y wss:// .
# OPENCLAW_BRIDGE_MODE=gateway
# OPENCLAW_GATEWAY_URL=http://100.x.x.x:18789
# OPENCLAW_GATEWAY_WS=ws://100.x.x.x:18789
# OPENCLAW_GATEWAY_TOKEN=<opcional mismo token que el gateway si auth.mode=token>
# Para abrir el dashboard desde otro PC en la tailnet usa `npm run dev:host` y entra por http://<IP_TAILSCALE_NUXT>:3000 .
# NUXT_PUBLIC_API_BASE suele vacío si el navegador y la API son el mismo origen (mismo host:puerto de Nuxt).
#
# Si ves 503 "connection refused" en /api/openclaw/agents: el proceso Node de Nuxt no puede abrir TCP al WebSocket.
# - En el PC del gateway: `openclaw gateway` (o el comando que uses) en marcha; puerto correcto (ej. 18789).
# - El gateway debe escuchar en 0.0.0.0, no solo 127.0.0.1, para LAN/Tailscale.
# - Desde el PC donde corre Nuxt: `curl -sS -o /dev/null -w "%{http_code}" http://<IP_GATEWAY>:18789/` o `nc -zv <IP> 18789`.
# - Tras cambiar .env, reinicia `npm run dev` (Nitro lee variables al arrancar).
OPENCLAW_BRIDGE_MODE=mock
OPENCLAW_GATEWAY_URL=http://127.0.0.1:18789
OPENCLAW_GATEWAY_WS=
# Obligatorio si el gateway usa auth.mode=token (mismo valor que en ~/.openclaw/openclaw.json o docs OpenClaw).
OPENCLAW_GATEWAY_TOKEN=
DATABASE_PATH=./data/mission-control.db

# Phase 4 — semantic memory & embeddings (server-only; leave URL empty for deterministic mock vectors)
NUXT_MEMORY_EMBEDDING_API_URL=
NUXT_MEMORY_EMBEDDING_API_KEY=
NUXT_MEMORY_EMBEDDING_MODEL=text-embedding-3-small
NUXT_MEMORY_EMBEDDING_DIMENSIONS=256
NUXT_MEMORY_SEARCH_MAX_SCAN=5000
NUXT_MEMORY_EMBED_CHAT_TURNS=false
NUXT_MEMORY_CHAT_RECENT_MESSAGES=40
NUXT_MEMORY_SEMANTIC_CONTEXT_LIMIT=5

# Session cookie encryption (min 32 chars). In dev, nuxt-auth-utils may append NUXT_SESSION_PASSWORD to .env if missing.
NUXT_SESSION_PASSWORD=

# Dashboard operator login (server-only). Replace with real values in your local `.env` (gitignored).
# Password must be at least 8 characters (validated on login form and POST /api/auth/login).
NUXT_MC_AUTH_EMAIL=operator@example.com
NUXT_MC_AUTH_PASSWORD=changeme-min-8-chars
# Optional: scrypt hash from nuxt-auth-utils (preferred over plain password in production):
# NUXT_MC_AUTH_PASSWORD_HASH=

# Legacy names (still read in server/api/auth/login.post.ts from process.env):
# MISSION_CONTROL_OPERATOR_EMAIL=
# MISSION_CONTROL_OPERATOR_PASSWORD=
# MISSION_CONTROL_OPERATOR_PASSWORD_HASH=
