# Copy to .env.playwright and adjust (optional). Matches playwright.config.ts webServer defaults.
# First-time local E2E: run `npm run playwright:install` to download Chromium.
# Override base URL if the server listens elsewhere:
# PLAYWRIGHT_BASE_URL=http://127.0.0.1:3000

# Operator login (must match NUXT_MC_AUTH_* on the Nitro process started by Playwright webServer)
PLAYWRIGHT_MC_EMAIL=e2e@test.local
PLAYWRIGHT_MC_PASSWORD=e2epassword12345

# Session crypto secret for nuxt-auth-utils (min 32 chars)
NUXT_SESSION_PASSWORD=01234567890123456789012345678901

# SQLite file for E2E (default: ./data/e2e-playwright.db).
# Also sets NUXT_DATABASE_PATH so Nitro uses this DB at runtime (not build-time default).
# PLAYWRIGHT_DATABASE_PATH=
