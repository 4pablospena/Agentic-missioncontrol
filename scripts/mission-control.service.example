[Unit]
Description=Mission Control Nuxt Server
After=network.target

[Service]
Type=simple
User=www-data
WorkingDirectory=/opt/mission-control-agentic
Environment=NODE_ENV=production
Environment=PORT=3000
ExecStart=/usr/bin/node .output/server/index.mjs
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
