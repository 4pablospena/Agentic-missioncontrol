{
  "name": "openclaw-mission-control",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "postbuild": "node scripts/copy-db-migrations.mjs",
    "dev": "nuxt dev",
    "dev:host": "nuxt dev --host 0.0.0.0",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "test": "vitest run",
    "test:integration": "npm run build && vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright install chromium && playwright test",
    "test:e2e:ui": "playwright install chromium && playwright test --ui",
    "playwright:install": "playwright install chromium",
    "test:all": "npm run test && npm run test:integration && npm run test:e2e",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push"
  },
  "dependencies": {
    "@nuxt/ui": "^4.7.1",
    "better-sqlite3": "^11.8.1",
    "croner": "^10.0.1",
    "drizzle-orm": "^0.38.4",
    "nuxt": "^4.4.4",
    "nuxt-auth-utils": "^0.5.29",
    "tailwindcss": "^4.1.18",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0",
    "ws": "^8.20.0",
    "zod": "^4.4.1"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.43",
    "@playwright/test": "^1.59.1",
    "@types/better-sqlite3": "^7.6.12",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/test-utils": "^2.4.6",
    "commander": "13.1.0",
    "drizzle-kit": "^0.30.4",
    "happy-dom": "^15.11.7",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5",
    "vitest-axe": "^0.1.0"
  }
}
